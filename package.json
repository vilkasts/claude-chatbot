{
  "name": "claude-chatbot",
  "version": "0.1.0",
  "description": "CLI chatbot built with the Anthropic Claude API — learning project",
  "type": "module",
  "main": "apps/cli/index.ts",
  "scripts": {
    "dev:cli": "node --watch --import tsx --env-file=.env apps/cli/index.ts",
    "dev:server": "node --watch --import tsx --env-file=.env apps/server/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:node": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "start:cli": "node --env-file=.env dist/apps/cli/index.js",
    "start:server": "node --env-file=.env dist/apps/server/index.js",
    "start:web": "vite preview --config apps/web/vite.config.ts",
    "eval": "tsx --env-file=.env bot/evals/runEval.ts",
    "tsc": "tsc --noEmit",
    "tsc:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
